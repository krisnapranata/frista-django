# ---------- Django ----------
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_DEBUG=false
# Nama host/IP server ini yang dipakai APM, pisahkan dengan koma
DJANGO_ALLOWED_HOSTS=frista.rs.local,192.168.10.20,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://frista.rs.local
TIME_ZONE=Asia/Makassar

# ---------- Akun FRISTA (pakai akun VClaim faskes) ----------
FRISTA_USERNAME=
FRISTA_PASSWORD=
FRISTA_BASE_URL=https://frista.bpjs-kesehatan.go.id
FRISTA_VERSION=3.0.2
FRISTA_VERIFY_SSL=true
FRISTA_TIMEOUT=30

# ---------- Kunci API ----------
# Untuk APK APM (hanya bisa membuat sesi & membaca hasil)
APM_API_KEY=ganti-kunci-apm
# Untuk petugas/SIMRS (bisa registrasi wajah) - JANGAN taruh di APK
ADMIN_API_KEY=ganti-kunci-admin

# ---------- Perilaku verifikasi ----------
CAPTURE_SESSION_TTL=180
FRISTA_MAX_ATTEMPTS=3
FACEAPI_MIN_SCORE=0.85
FACEAPI_STABLE_FRAMES=3

# ---------- Cache (opsional, untuk lebih dari 1 server) ----------
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1

LOG_LEVEL=INFO

# ---------- Docker + Nginx Proxy Manager (opsional) ----------
# Aktifkan bila NPM berjalan di Docker pada server yang sama: container ikut
# jaringan NPM dan port 8010 tidak dibuka ke host. Lihat docker-compose.npm.yml.
# COMPOSE_FILE=docker-compose.yml:docker-compose.npm.yml
# NPM_NETWORK=proxy_default
